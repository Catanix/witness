# Шаблон пресета для dev-сборки телефона.
# Скопируйте в .env.dev (он в .gitignore — НЕ коммитить) и заполните своими значениями.
# Используется только flavor'ом `dev` (:mobile:assembleDevDebug).
# Публичный `git`-билд эти значения НЕ использует — там всё вводится в настройках приложения.

WITNESS_ASR_URL=https://<ваш-asr-endpoint>/api/v1/services/aigc/multimodal-generation/generation
WITNESS_ASR_MODEL=qwen-audio-3.0-asr-flash
WITNESS_LLM_URL=https://<ваш-llm-endpoint>/compatible-mode/v1
WITNESS_LLM_MODEL=qwen4-max-preview
WITNESS_API_KEY=<ваш-ключ>